node_modules/
dist/
dist-electron/
release/
data/
*.log
.DS_Store

# IDE / Android Studio project files
.idea/

# Capacitor Android build outputs (the android/ project itself IS tracked;
# cap add android writes its own android/.gitignore for these).
android/app/build/
android/build/
android/.gradle/
android/capacitor-cordova-android-plugins/
.env
.env.local
tsconfig.tsbuildinfo

# Whisper — binaries and 3 GB model are too large for git. CI downloads them
# fresh on each build (see .github/workflows/build.yml).
resources/whisper/ggml-*.bin
resources/whisper/whisper.cpp/
resources/whisper/whisper-cli
resources/whisper/whisper-cli.exe
resources/whisper/main
resources/whisper/main.exe
resources/whisper/*.dll
resources/whisper/*.dylib
resources/whisper/whisper-bin-win/
resources/whisper/whisper-bin-*/

# Tamil Bible — downloaded + compiled by CI from godlytalias repo on each build.
resources/bible/tamil-ov-source.json
resources/bible/tamil-ov.json

# User-provided icon — commit if you want it in CI builds; ignore by default.
# Comment the next line out if you've added icon.png and want it shipped.
resources/icons/icon.png

# macOS .dmg etc.
*.dmg
*.dmg.blockmap
release/

# Mobile: optional full verse DB override (copy tamil-ov.json here for release)
public/verses.full.json

# Android release signing — NEVER commit
android/keystore.properties
*.jks
*.keystore

# Capacitor asset source (icon of record lives in resources/icons/)
assets/

# Firebase app config (from the Firebase console) — kept out of the public repo.
android/app/google-services.json
# Firebase service-account key — a secret; stored only as the FCM_SERVICE_ACCOUNT Worker secret.
*firebase*adminsdk*.json
