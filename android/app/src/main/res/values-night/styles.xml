<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Phone in dark mode: the app follows it (Settings → Display → Same as phone), so the
         system navigation bar goes dark too instead of a white strip under the tab bar. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">#0b1413</item>
        <item name="android:navigationBarColor">#12201d</item>
    </style>
</resources>
