# Copy to android/keystore.properties (gitignored) and fill in real values.
# Create the keystore once with:
#   keytool -genkey -v -keystore android/upload-keystore.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# storeFile is resolved relative to android/app/, so ../upload-keystore.jks
# points at android/upload-keystore.jks.
storeFile=../upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
